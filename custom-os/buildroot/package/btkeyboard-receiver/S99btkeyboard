#!/bin/sh
#
# Start/stop the BT Keyboard appliance receiver.
#

DAEMON=/opt/btkeyboard/linux_receiver.py
PIDFILE=/var/run/btkeyboard.pid
NAME=btkeyboard

start() {
	printf 'Starting %s: ' "$NAME"
	modprobe uinput 2>/dev/null
	start-stop-daemon -S -q -m -p "$PIDFILE" -b \
		-d /opt/btkeyboard --exec /usr/bin/python3 -- "$DAEMON"
	echo "OK"
}

stop() {
	printf 'Stopping %s: ' "$NAME"
	start-stop-daemon -K -q -p "$PIDFILE"
	echo "OK"
}

restart() {
	stop
	start
}

case "$1" in
	start) start ;;
	stop) stop ;;
	restart | reload) restart ;;
	*)
		echo "Usage: $0 {start|stop|restart}"
		exit 1
		;;
esac

exit $?
